<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Share the app code without executing its browser entry point. -->
    <Compile Include="../src/Config.fs" />
    <Compile Include="../src/State.fs" />
    <Compile Include="../src/Stops.fs" />
    <Compile Include="../src/Location.fs" />
    <Compile Include="../src/Feed.fs" />
    <Compile Include="../src/Timers.fs" />
    <Compile Include="../src/Ui.fs" />
    <Compile Include="../src/App.fs" />
    <Compile Include="Fixtures.fs" />
    <Compile Include="App.test.fs" />
    <Compile Include="Feed.test.fs" />
    <Compile Include="Bundle.test.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="4.5.0" />
    <PackageReference Include="Fable.Elmish" Version="5.0.2" />
    <PackageReference Include="Feliz" Version="3.3.3" />
    <PackageReference Include="Feliz.Bulma" Version="5.0.0" />
    <PackageReference Include="Feliz.UseElmish" Version="5.0.0" />
    <PackageReference Include="Vitest" Version="2.0.0" />
    <PackageReference Include="Vitest.JestDom" Version="1.0.0" />
    <PackageReference Include="Vitest.ReactTestingLibrary" Version="1.1.0" />
  </ItemGroup>
</Project>
