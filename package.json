{
  "name": "greenpoint-subway-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fable watch App.fsproj --run vite",
    "build": "fable App.fsproj && vite build",
    "preview": "vite preview",
    "typecheck": "dotnet build App.fsproj && dotnet build tests/Tests.fsproj",
    "test": "npm run build && fable tests/Tests.fsproj && NODE_ENV=test vitest run",
    "test:watch": "npm run build && NODE_ENV=test fable watch tests/Tests.fsproj --run vitest",
    "test:e2e": "npm test"
  },
  "dependencies": {
    "bulma": "1.0.4",
    "gtfs-realtime-bindings": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^31.0.0",
    "sass": "1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}
